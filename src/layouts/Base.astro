---
import ExternalArrow from '../components/ExternalArrow.astro';
import site from '../../site.config.mjs';
import { albumPath } from '../lib/data.mjs';
import Viewer from '../components/Viewer.astro';
import KeyboardHelp from '../components/KeyboardHelp.astro';
import InstagramLink from '../components/InstagramLink.astro';
import '../style.css';
const { title, active, image, imageWidth = 1200, imageHeight = 630 } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = new URL(image || '/og.jpg', site.url);
const documentTitle = `Andrew Ng Images — ${title}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content="Photographs by Andrew Ng. Portraits, landscapes, denim, and small things worth a closer look." />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Andrew Ng Images" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={imageWidth} />
    <meta property="og:image:height" content={imageHeight} />
    <meta property="og:image:alt" content={image ? 'Photograph by Andrew Ng' : 'Andrew Ng Images — photography portfolio'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="site">
      <header class="sidebar">
        <a class="identity" href="/">Andrew Ng<span>Photography</span></a>
        <nav aria-label="Albums">
          {site.albums.map(album => <a href={albumPath(album)} aria-current={album.slug === active ? 'page' : undefined}>{album.title}</a>)}
        </nav>
        <nav class="secondary" aria-label="Information">
          <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>About</a>
          <a href="https://andrewng.com/">Elsewhere <ExternalArrow /></a>
          {site.instagramUrl && <InstagramLink href={site.instagramUrl} />}
        </nav>
        <p class="copyright">© <span data-copyright-year>{new Date().getFullYear()}</span> Andrew Ng</p>
      </header>
      <main id="main">
        <div class="page-heading"><h1>{title}</h1></div>
        <slot />
      </main>
    </div>
    <Viewer />
    <KeyboardHelp />
    <script>
      import "../copyright.js";
    </script>
  </body>
</html>
