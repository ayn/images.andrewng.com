---
const { href, label = 'Instagram', text = false } = Astro.props;
---
<a href={href} class:list={['instagram-link', { 'instagram-link-with-text': text }]} aria-label={label} title={label}>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
  </svg>
  {text && <span>Instagram ↗</span>}
</a>
