<dialog class="viewer" aria-label="Photograph viewer">
  <div class="viewer-top">
    <span id="position" aria-live="polite"></span>
    <button class="close" aria-label="Close viewer">Close <span aria-hidden="true">×</span></button>
  </div>
  <div class="viewer-stage">
    <button class="previous" aria-label="Previous photograph">←</button>
    <div class="viewer-photo-stack"><img id="viewer-image" alt="" tabindex="-1" /></div>
    <button class="next" aria-label="Next photograph">→</button>
  </div>
  <div class="viewer-bottom">
    <div class="viewer-links"><button class="details-toggle" aria-expanded="false" aria-controls="photo-details">Details</button></div>
    <p id="photo-details" hidden></p>
  </div>
</dialog>
<script>
  import '../gallery.js';
</script>
