---
import PhotoArrow from './PhotoArrow.astro';
---
<dialog class="viewer" aria-label="Photograph viewer">
  <div class="viewer-top">
    <span id="position" aria-live="polite"></span>
    <button class="close" aria-label="Close viewer">Close <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="m3 3 10 10M13 3 3 13" /></svg></button>
  </div>
  <div class="viewer-stage">
    <button class="previous" aria-label="Previous photograph"><PhotoArrow previous /></button>
    <div class="viewer-photo-stack"><img id="viewer-image" alt="" tabindex="-1" /></div>
    <button class="next" aria-label="Next photograph"><PhotoArrow /></button>
  </div>
  <div class="viewer-bottom">
    <div class="viewer-links"><button class="details-toggle" aria-keyshortcuts="d" aria-expanded="false" aria-controls="photo-details">Details</button></div>
    <p id="photo-details" hidden></p>
  </div>
</dialog>
<script>
  import '../gallery.js';
</script>
