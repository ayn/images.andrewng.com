---
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { loadPortfolio } from '../../lib/data.mjs';
export async function getStaticPaths() {
  const { albums } = await loadPortfolio();
  return albums.filter(album => album.slug !== 'selected-images').map(album => ({ params: { slug: album.slug }, props: { album } }));
}
const { album } = Astro.props;
---
<Base title={album.title} active={album.slug}>
  <Gallery album={album} />
</Base>
